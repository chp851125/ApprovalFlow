@model EmployeeDetailsViewModel
@{
    var e = Model.Employee;
    ViewData["Title"] = e.Name;
    var editable = Model.CanManage;
}
<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <span class="avatar avatar-xl @(e.IsActive ? "bg-primary text-white" : "bg-secondary-subtle text-secondary")">@e.Name[..1]</span>
        <div>
            <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">員工帳號</a></li><li class="breadcrumb-item active">@e.Name</li></ol></nav>
            <h1 class="page-title">@e.Name <small class="fs-6 text-body-secondary fw-normal">@e.Account・@e.EmployeeNo</small></h1>
            <div class="small text-body-secondary">@Model.DepartmentName・@Model.TitleName</div>
        </div>
    </div>
    @if (editable)
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id"><i class="bi bi-pencil me-1"></i>編輯資料</a>
    }
</div>

@if (!e.IsActive)
{
    <div class="alert alert-secondary"><i class="bi bi-person-dash me-1"></i>此帳號已停用（離職日 @e.ResignedDate?.ToString("yyyy/MM/dd")），無法登入。</div>
}
else if (Model.IsLocked)
{
    <div class="alert alert-danger"><i class="bi bi-lock-fill me-1"></i>此帳號因多次登入失敗被鎖定至 @e.LockoutEnd?.ToString("MM/dd HH:mm")。</div>
}
@if (Model.PendingTasks > 0)
{
    <div class="alert alert-warning small"><i class="bi bi-inbox me-1"></i>目前有 <strong>@Model.PendingTasks</strong> 張單據待此人簽核。若要停用帳號，建議先完成交接（設定代理或轉簽）。</div>
}
@if (!editable)
{
    <div class="alert alert-info small"><i class="bi bi-info-circle me-1"></i>系統管理員帳號只能由系統管理員維護，您僅能檢視。</div>
}

<div class="row g-3">
    <div class="col-lg-7 d-flex flex-column gap-3">
        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-person-vcard me-2"></i>基本資料</div>
            <div class="card-body">
                <dl class="row mb-0 dl-compact">
                    <dt class="col-4 col-sm-3">Email</dt><dd class="col-8 col-sm-9 text-break">@e.Email</dd>
                    <dt class="col-4 col-sm-3">手機</dt><dd class="col-8 col-sm-9">@(e.Phone ?? "—")</dd>
                    <dt class="col-4 col-sm-3">分機</dt><dd class="col-8 col-sm-9">@(e.Extension ?? "—")</dd>
                    <dt class="col-4 col-sm-3">到職日</dt><dd class="col-8 col-sm-9">@e.HireDate.ToString("yyyy/MM/dd")</dd>
                    <dt class="col-4 col-sm-3">直屬主管</dt>
                    <dd class="col-8 col-sm-9">
                        @if (Model.Manager != null)
                        {
                            <a asp-action="Details" asp-route-id="@Model.Manager.Id">@Model.Manager.Name</a>
                            @if (!Model.Manager.IsActive) { <span class="badge text-bg-secondary ms-1">已停用</span> }
                        }
                        else { <span>—</span> }
                    </dd>
                    <dt class="col-4 col-sm-3">部門主管</dt><dd class="col-8 col-sm-9">@(Model.HeadOfDepartments.Count > 0 ? string.Join("、", Model.HeadOfDepartments) : "—")</dd>
                    <dt class="col-4 col-sm-3">最後登入</dt><dd class="col-8 col-sm-9">@(e.LastLoginAt?.ToString("yyyy/MM/dd HH:mm") ?? "尚未登入")</dd>
                    <dt class="col-4 col-sm-3">密碼變更</dt>
                    <dd class="col-8 col-sm-9">
                        @(e.PasswordChangedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")
                        @if (e.MustChangePassword) { <span class="badge text-bg-warning ms-1">下次登入須變更</span> }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-people me-2"></i>直屬部屬（@Model.DirectReports.Count）</div>
            @if (Model.DirectReports.Count == 0)
            {
                <div class="card-body small text-body-secondary">沒有直屬部屬。</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var r in Model.DirectReports)
                    {
                        <a class="list-group-item list-group-item-action d-flex justify-content-between" asp-action="Details" asp-route-id="@r.Id">
                            <span>@r.Name <small class="text-body-secondary">@r.Account</small></span><i class="bi bi-chevron-right text-body-secondary"></i>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-person-check me-2"></i>生效中 / 未來的代理設定</div>
            @if (Model.Delegations.Count == 0)
            {
                <div class="card-body small text-body-secondary">沒有代理設定。</div>
            }
            else
            {
                <ul class="list-group list-group-flush small">
                    @foreach (var d in Model.Delegations)
                    {
                        <li class="list-group-item">
                            <span class="fw-semibold">@Model.Names.GetValueOrDefault(d.PrincipalId)</span><i class="bi bi-arrow-right mx-1"></i><span class="fw-semibold">@Model.Names.GetValueOrDefault(d.DelegateId)</span>
                            <span class="text-body-secondary ms-2">@d.StartDate.ToString("yyyy/MM/dd")～@d.EndDate.ToString("yyyy/MM/dd")</span>
                            @if (d.IsEffectiveOn(Model.Today)) { <span class="badge text-bg-success ms-1">生效中</span> }
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-journal-text me-2"></i>帳號異動紀錄</div>
            @if (Model.RecentAudits.Count == 0)
            {
                <div class="card-body small text-body-secondary">沒有紀錄。</div>
            }
            else
            {
                <ul class="list-group list-group-flush small">
                    @foreach (var a in Model.RecentAudits)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between gap-2">
                                <span>@a.Description</span>
                                <span class="text-body-secondary text-nowrap">@a.At.ToString("MM/dd HH:mm")</span>
                            </div>
                            <div class="text-body-secondary">@a.UserName</div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="col-lg-5 d-flex flex-column gap-3">
        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-shield-check me-2"></i>角色設定</div>
            <div class="card-body">
                @if (editable && e.IsActive)
                {
                    <form method="post" asp-action="UpdateRoles">
                        <input type="hidden" name="id" value="@e.Id" />
                        <input type="hidden" name="version" value="@e.Version" />
                        <partial name="_RoleCheckboxes" model="@(new RoleCheckboxModel("roles", e.Roles, Model.CanAssignAdmin))" />
                        <button type="submit" class="btn btn-primary mt-3 w-100"><i class="bi bi-check-lg me-1"></i>儲存角色</button>
                    </form>
                }
                else
                {
                    @foreach (var role in e.Roles)
                    {
                        <span class="badge role-badge role-@role.ToLowerInvariant() me-1">@Roles.ToDisplay(role)</span>
                    }
                }
            </div>
        </div>

        @if (editable)
        {
            <div class="card">
                <div class="card-header fw-semibold"><i class="bi bi-key me-2"></i>帳號安全</div>
                <div class="card-body d-grid gap-2">
                    @if (e.IsActive)
                    {
                        <form method="post" asp-action="ResetPassword" data-confirm="確定要重設「@e.Name」的密碼嗎？系統會產生臨時密碼，並登出此人所有裝置。">
                            <input type="hidden" name="id" value="@e.Id" />
                            <input type="hidden" name="version" value="@e.Version" />
                            <button type="submit" class="btn btn-outline-warning w-100"><i class="bi bi-arrow-repeat me-1"></i>重設密碼</button>
                        </form>
                    }
                    @if (Model.IsLocked || e.FailedLoginCount > 0)
                    {
                        <form method="post" asp-action="Unlock">
                            <input type="hidden" name="id" value="@e.Id" />
                            <input type="hidden" name="version" value="@e.Version" />
                            <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-unlock me-1"></i>解除鎖定（失敗次數 @e.FailedLoginCount）</button>
                        </form>
                    }
                </div>
            </div>

            <div class="card border-danger-subtle">
                <div class="card-header fw-semibold text-danger"><i class="bi bi-person-dash me-2"></i>在職狀態</div>
                <div class="card-body">
                    @if (e.IsActive)
                    {
                        @if (Model.IsSelf)
                        {
                            <p class="small text-body-secondary mb-0">不可停用自己的帳號。</p>
                        }
                        else
                        {
                            <form method="post" asp-action="Deactivate" data-confirm="確定要停用「@e.Name」嗎？此人將立即被登出，相關代理設定也會一併取消。">
                                <input type="hidden" name="id" value="@e.Id" />
                                <input type="hidden" name="version" value="@e.Version" />
                                <label class="form-label small" for="resignedDate">離職日</label>
                                <div class="input-group">
                                    <input type="date" class="form-control" id="resignedDate" name="resignedDate" value="@Model.Today.ToString("yyyy-MM-dd")" />
                                    <button type="submit" class="btn btn-outline-danger">停用帳號</button>
                                </div>
                                <div class="form-text">若此人是部門主管或仍有直屬部屬，需先完成調整。</div>
                            </form>
                        }
                    }
                    else
                    {
                        <form method="post" asp-action="Reactivate" data-confirm="確定要讓「@e.Name」復職嗎？">
                            <input type="hidden" name="id" value="@e.Id" />
                            <input type="hidden" name="version" value="@e.Version" />
                            <button type="submit" class="btn btn-outline-success w-100"><i class="bi bi-person-check me-1"></i>復職並啟用帳號</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
