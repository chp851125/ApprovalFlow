@model PasswordIssuedViewModel
@{
    ViewData["Title"] = Model.IsNewAccount ? "帳號已建立" : "密碼已重設";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4 text-center">
                <div class="display-6 text-success mb-2"><i class="bi bi-check-circle-fill"></i></div>
                <h1 class="h4 mb-1">@ViewData["Title"]</h1>
                <p class="text-body-secondary">@Model.EmployeeName（@Model.Account）的臨時密碼如下：</p>
                <div class="temp-password user-select-all" id="tempPassword">@Model.TempPassword</div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2 js-copy" data-copy-target="#tempPassword">
                    <i class="bi bi-clipboard me-1"></i>複製
                </button>
                <div class="alert alert-warning text-start small mt-4 mb-3">
                    <ul class="mb-0 ps-3">
                        <li>此密碼<strong>只會顯示這一次</strong>，離開此頁後無法再查看。</li>
                        <li>請以安全的方式交給本人，對方第一次登入時必須變更密碼。</li>
                        @if (!Model.IsNewAccount) { <li>此人原本的登入已全部失效。</li> }
                    </ul>
                </div>
                <a class="btn btn-primary" asp-action="Details" asp-route-id="@Model.EmployeeId">回到員工資料</a>
            </div>
        </div>
    </div>
</div>
