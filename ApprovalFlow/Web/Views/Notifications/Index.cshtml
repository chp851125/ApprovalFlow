@model NotificationIndexViewModel
@{
    ViewData["Title"] = "通知中心";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="page-header">
    <div>
        <h1 class="page-title">通知中心</h1>
        <div class="text-body-secondary small">未讀 @Model.UnreadCount 則。點擊通知會開啟相關單據並標示為已讀。</div>
    </div>
    @if (Model.UnreadCount > 0)
    {
        <form method="post" asp-action="MarkAllRead">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-check2-all me-1"></i>全部標為已讀</button>
        </form>
    }
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(Model.Filter == "all" ? "active" : "")" asp-action="Index" asp-route-filter="all">全部</a></li>
    <li class="nav-item"><a class="nav-link @(Model.Filter == "unread" ? "active" : "")" asp-action="Index" asp-route-filter="unread">未讀 @if (Model.UnreadCount > 0) { <span class="badge text-bg-danger ms-1">@Model.UnreadCount</span> }</a></li>
</ul>

@if (Model.Rows.TotalCount == 0)
{
    <div class="card"><div class="card-body empty-state py-5">
        <div class="empty-state-icon"><i class="bi bi-bell-slash"></i></div>
        <p class="text-body-secondary mb-0">@(Model.Filter == "unread" ? "沒有未讀通知" : "目前沒有通知")</p>
    </div></div>
}
else
{
    <div class="card">
        <ul class="list-group list-group-flush">
            @foreach (var n in Model.Rows.Items)
            {
                var (icon, color) = n.Type.ToIcon();
                <li class="list-group-item notification-item @(n.IsRead ? "" : "is-unread")">
                    <div class="d-flex gap-3">
                        <span class="notification-icon bg-@color-subtle text-@color-emphasis"><i class="bi @icon"></i></span>
                        <a class="min-w-0 flex-grow-1 text-decoration-none text-body" asp-action="Open" asp-route-id="@n.Id">
                            <div class="d-flex justify-content-between gap-2">
                                <span class="fw-semibold text-truncate">@n.Title</span>
                                <span class="small text-body-secondary text-nowrap">@n.CreatedAt.ToString("MM/dd HH:mm")</span>
                            </div>
                            <div class="small text-body-secondary">@n.Message</div>
                            <span class="badge text-bg-light border mt-1">@n.Type.ToDisplay()</span>
                        </a>
                        @if (!n.IsRead)
                        {
                            <form method="post" asp-action="MarkRead" class="flex-shrink-0">
                                <input type="hidden" name="id" value="@n.Id" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-sm btn-link text-body-secondary p-0" title="標為已讀" aria-label="標為已讀"><i class="bi bi-check2"></i></button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    </div>
}
<partial name="_Pager" model="Model.Pager" />
