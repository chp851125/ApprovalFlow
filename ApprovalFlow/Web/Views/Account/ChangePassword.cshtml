@model ChangePasswordViewModel
@{
    ViewData["Title"] = "變更密碼";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="page-header">
            <h1 class="page-title">變更密碼</h1>
        </div>
        @if (Model.IsForced)
        {
            <div class="alert alert-warning"><i class="bi bi-shield-exclamation me-1"></i>您目前使用的是臨時密碼，請先設定新密碼才能繼續使用系統。</div>
        }
        <div class="card">
            <div class="card-body">
                <form method="post" asp-action="ChangePassword" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.CurrentPassword" class="form-label required"></label>
                        <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Input.CurrentPassword" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label required"></label>
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                        <div class="form-text">密碼規則：@Model.PolicyText，且不可包含帳號。</div>
                        <span asp-validation-for="Input.NewPassword" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label required"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="invalid-feedback d-block"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-lg me-1"></i>變更密碼</button>
                    <div class="small text-body-secondary mt-2">變更後，您在其他裝置上的登入將會失效。</div>
                </form>
            </div>
        </div>
    </div>
</div>
