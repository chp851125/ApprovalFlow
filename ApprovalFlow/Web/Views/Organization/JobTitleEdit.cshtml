@model JobTitleEditViewModel
@{
    var isNew = Model.Input.Id == 0;
    ViewData["Title"] = isNew ? "新增職稱" : "編輯職稱";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index" asp-route-tab="title">組織架構</a></li><li class="breadcrumb-item active">@ViewData["Title"]</li></ol></nav>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        @if (!Model.IsActive)
        {
            <div class="alert alert-secondary small"><i class="bi bi-slash-circle me-1"></i>此職稱目前為停用狀態。</div>
        }
        <form method="post" asp-action="SaveJobTitle" novalidate>
            <input type="hidden" asp-for="Input.Id" />
            <input type="hidden" asp-for="Input.Version" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>
            <div class="row g-3">
                <div class="col-sm-4">
                    <label asp-for="Input.Code" class="form-label required"></label>
                    <input asp-for="Input.Code" class="form-control text-uppercase" maxlength="10" />
                    <span asp-validation-for="Input.Code" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-sm-8">
                    <label asp-for="Input.Name" class="form-label required"></label>
                    <input asp-for="Input.Name" class="form-control" maxlength="20" />
                    <span asp-validation-for="Input.Name" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-sm-4">
                    <label asp-for="Input.Rank" class="form-label"></label>
                    <input asp-for="Input.Rank" class="form-control" type="number" min="1" max="99" />
                    <span asp-validation-for="Input.Rank" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-sm-4">
                    <label asp-for="Input.SortOrder" class="form-label"></label>
                    <input asp-for="Input.SortOrder" class="form-control" type="number" min="0" max="999" />
                    <span asp-validation-for="Input.SortOrder" class="invalid-feedback d-block"></span>
                </div>
            </div>
            <div class="form-actions">
                <a asp-action="Index" asp-route-tab="title" class="btn btn-outline-secondary">取消</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>儲存</button>
            </div>
        </form>
    </div>
</div>
