@model (ExpenseItemInput Item, string Index, DocumentEditViewModel Page)
@{
    var it = Model.Item;
    var p = $"Input.Expense.Items[{Model.Index}]";
    var errorKey = $"Input.Expense.Items[{Model.Index}]";
    var errors = ViewContext.ViewData.ModelState
        .Where(kv => kv.Key.StartsWith(errorKey + ".", StringComparison.Ordinal))
        .SelectMany(kv => kv.Value!.Errors.Select(e => e.ErrorMessage)).Distinct().ToList();
}
<div class="line-item" data-line-row>
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">日期</label>
            <input type="date" class="form-control form-control-sm" name="@(p).Date" value="@it.Date?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">類別</label>
            <select class="form-select form-select-sm" name="@(p).CategoryId">
                <option value="0">請選擇</option>
                @foreach (var c in Model.Page.CategoryInfo.Where(c => c.IsActive || c.Id == it.CategoryId))
                {
                    <option value="@c.Id" selected="@(c.Id == it.CategoryId)">@c.Name@(c.RequiresReceipt ? "（需收據）" : "")</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small mb-1">說明</label>
            <input class="form-control form-control-sm" name="@(p).Description" value="@it.Description" maxlength="100" />
        </div>
        <div class="col-5 col-md-2">
            <label class="form-label small mb-1">發票 / 收據號碼</label>
            <input class="form-control form-control-sm text-uppercase" name="@(p).ReceiptNo" value="@it.ReceiptNo" maxlength="30" />
        </div>
        <div class="col-5 col-md-1">
            <label class="form-label small mb-1">金額</label>
            <input type="number" class="form-control form-control-sm text-end" name="@(p).Amount" value="@it.Amount?.ToString("0")" min="0" step="1" inputmode="numeric" data-line-amount />
        </div>
        <div class="col-2 col-md-1 text-end">
            <button type="button" class="btn btn-sm btn-outline-danger" data-line-remove title="刪除此筆" aria-label="刪除此筆"><i class="bi bi-trash"></i></button>
        </div>
    </div>
    @foreach (var e in errors) { <div class="invalid-feedback d-block">@e</div> }
</div>
