@model WorkflowTemplateIndexViewModel
@{
    ViewData["Title"] = "簽核流程";
}
<div class="page-header">
    <div>
        <h1 class="page-title">簽核流程</h1>
        <div class="text-body-secondary small">每個單別同時只有一個「使用中」版本。修改流程請建立新版本並啟用；已送出的單據會沿用送出當時的版本。</div>
    </div>
</div>

<div class="row g-3">
    @foreach (var (type, versions) in Model.Groups)
    {
        var active = versions.FirstOrDefault(v => v.Template.IsActive);
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold"><i class="bi bi-file-earmark-text me-2"></i>@type.ToDisplay()</span>
                    @if (active != null)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="NewVersion" asp-route-id="@active.Template.Id"><i class="bi bi-plus-lg me-1"></i>建立新版本</a>
                    }
                </div>
                @if (active == null)
                {
                    <div class="card-body"><div class="alert alert-warning small mb-0"><i class="bi bi-exclamation-triangle me-1"></i>此單別沒有使用中的流程，員工將無法送出。</div></div>
                }
                else
                {
                    <div class="card-body pb-2">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <a class="fw-semibold" asp-action="Details" asp-route-id="@active.Template.Id">@active.Template.Name</a>
                                <span class="badge text-bg-success ms-1">使用中 v@(active.Template.TemplateVersion)</span>
                            </div>
                            <span class="small text-body-secondary text-nowrap">@active.Usage 張單據</span>
                        </div>
                        <ol class="template-mini">
                            @foreach (var s in active.Template.Steps.OrderBy(s => s.StepNo))
                            {
                                <li>
                                    <span class="fw-semibold">@s.Name</span>
                                    <span class="small text-body-secondary">— <partial name="_StepSummary" model="(s, Model.Names)" /></span>
                                    @if (s.Condition != null) { <span class="badge text-bg-warning-subtle text-warning-emphasis border ms-1">@s.Condition.Describe()</span> }
                                </li>
                            }
                        </ol>
                    </div>
                }
                @if (versions.Count > 0)
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var v in versions.Where(v => !v.Template.IsActive))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <a asp-action="Details" asp-route-id="@v.Template.Id">v@(v.Template.TemplateVersion)・@v.Template.Name</a>
                                <span class="text-body-secondary text-nowrap">
                                    @if (v.Editable) { <span class="badge text-bg-info">草稿</span> }
                                    else { <span>已停用・@v.Usage 張單據</span> }
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>
