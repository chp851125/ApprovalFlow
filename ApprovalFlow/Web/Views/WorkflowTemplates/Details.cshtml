@model WorkflowTemplateDetailsViewModel
@{
    var t = Model.Template;
    ViewData["Title"] = $"{t.DocumentType.ToDisplay()}流程 v{t.TemplateVersion}";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">簽核流程</a></li><li class="breadcrumb-item active">@t.DocumentType.ToDisplay() v@(t.TemplateVersion)</li></ol></nav>
        <h1 class="page-title">
            @t.Name
            @if (t.IsActive) { <span class="badge text-bg-success fs-6 align-middle">使用中</span> }
            else if (Model.Editable) { <span class="badge text-bg-info fs-6 align-middle">草稿</span> }
            else { <span class="badge text-bg-secondary fs-6 align-middle">已停用</span> }
        </h1>
        <div class="small text-body-secondary">
            @t.DocumentType.ToDisplay()・第 @t.TemplateVersion 版・@(t.IsActive ? $"自 {t.EffectiveFrom:yyyy/MM/dd} 起使用" : $"建立於 {t.CreatedAt:yyyy/MM/dd}")・已有 @Model.Usage 張單據使用
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.Editable)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@t.Id"><i class="bi bi-pencil me-1"></i>編輯</a>
            <form method="post" asp-action="Delete" data-confirm="確定要刪除這個草稿版本嗎？">
                <input type="hidden" name="id" value="@t.Id" /><input type="hidden" name="version" value="@t.Version" />
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
        }
        <a class="btn btn-outline-secondary" asp-action="NewVersion" asp-route-id="@t.Id"><i class="bi bi-copy me-1"></i>另存新版本</a>
        @if (!t.IsActive)
        {
            <form method="post" asp-action="Activate" data-confirm="啟用後，之後送出的@(t.DocumentType.ToDisplay())都會使用此版本（已送出的單據不受影響）。確定要啟用嗎？">
                <input type="hidden" name="id" value="@t.Id" /><input type="hidden" name="version" value="@t.Version" />
                <button type="submit" class="btn btn-success"><i class="bi bi-play-circle me-1"></i>啟用此版本</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(t.Description))
{
    <div class="alert alert-light border small"><i class="bi bi-journal-text me-1"></i>@t.Description</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-diagram-2 me-2"></i>關卡設定（@t.Steps.Count）</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th>#</th><th>關卡</th><th>簽核人</th><th>條件</th><th class="text-end">時效</th><th class="text-center">可撤回</th></tr></thead>
                    <tbody>
                        @foreach (var s in t.Steps.OrderBy(s => s.StepNo))
                        {
                            <tr>
                                <td>@s.StepNo</td>
                                <td class="fw-semibold">@s.Name</td>
                                <td class="small"><partial name="_StepSummary" model="(s, Model.Names)" /></td>
                                <td class="small">@(s.Condition?.Describe() ?? "一律經過")</td>
                                <td class="text-end small text-nowrap">@(s.SlaHours is int h ? $"{h} 小時" : "系統預設")</td>
                                <td class="text-center">@if (s.AllowWithdraw) { <i class="bi bi-check-lg text-success"></i> } else { <i class="bi bi-dash text-body-secondary"></i> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-body small text-body-secondary border-top">
                <i class="bi bi-info-circle me-1"></i>
                條件不符、找不到簽核人、或與前一關簽核人相同（會簽除外）的關卡會自動略過；申請人不會成為自己單據的簽核人。
            </div>
        </div>

        @if (Model.OtherVersions.Count > 0)
        {
            <div class="card mt-3">
                <div class="card-header fw-semibold"><i class="bi bi-clock-history me-2"></i>其他版本</div>
                <ul class="list-group list-group-flush small">
                    @foreach (var v in Model.OtherVersions)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@v.Template.Id">v@(v.Template.TemplateVersion)・@v.Template.Name</a>
                            <span class="text-body-secondary">@(v.Template.IsActive ? "使用中" : "未使用中")・@v.Usage 張單據</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-calculator me-2"></i>流程試算</div>
            <div class="card-body">
                <form method="get" asp-action="Details" asp-route-id="@t.Id" class="row g-2 align-items-end">
                    <div class="col-12">
                        <label class="form-label small mb-1" for="ApplicantId">申請人</label>
                        <select class="form-select" id="ApplicantId" name="ApplicantId" asp-items="Model.Applicants">
                            <option value="">請選擇</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1" for="Amount">金額</label>
                        <input class="form-control" type="number" min="0" step="1" id="Amount" name="Amount" value="@Model.Preview.Amount" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1" for="Hours">時數</label>
                        <input class="form-control" type="number" min="0" step="0.5" id="Hours" name="Hours" value="@Model.Preview.Hours" />
                    </div>
                    <div class="col-12"><button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-play me-1"></i>試算簽核關卡</button></div>
                </form>

                @if (Model.PreviewError != null)
                {
                    <div class="alert alert-danger small mt-3 mb-0">@Model.PreviewError</div>
                }
                @if (Model.PreviewSteps != null)
                {
                    <ol class="flow-steps mt-3 mb-0">
                        @foreach (var s in Model.PreviewSteps)
                        {
                            <li class="flow-step @(s.Status == StepStatus.Skipped ? "is-skipped" : "is-active")">
                                <div class="flow-step-dot"><span>@s.StepNo</span></div>
                                <div class="flow-step-body small">
                                    <div class="fw-semibold">@s.Name @if (s.Assignees.Count > 1) { <span class="badge text-bg-light border">@s.Mode.ToDisplay()</span> }</div>
                                    @if (s.Status == StepStatus.Skipped)
                                    {
                                        <div class="text-body-secondary">略過：@s.SkipReason</div>
                                    }
                                    else
                                    {
                                        <div>@string.Join("、", s.Assignees.Select(a => Model.Names.GetValueOrDefault(a.EmployeeId)))</div>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                    @if (Model.PreviewSteps.All(s => s.Status == StepStatus.Skipped))
                    {
                        <div class="alert alert-warning small mt-2 mb-0">所有關卡都被略過，送出後會直接核准。</div>
                    }
                }
            </div>
        </div>
    </div>
</div>
