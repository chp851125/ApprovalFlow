@model List<ExpenseCategoryRow>
@{
    ViewData["Title"] = "費用類別";
}
<div class="page-header">
    <div>
        <h1 class="page-title">費用類別</h1>
        <div class="text-body-secondary small">費用報銷單的明細需選擇類別；單筆上限與是否需附收據會在送出時檢查。</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>新增類別</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>代碼</th><th>類別</th><th>預算科目</th><th class="text-end">單筆上限</th><th class="text-center">需收據</th><th class="text-center">狀態</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var x = r.Category;
                    <tr class="@(x.IsActive ? "" : "text-body-secondary")">
                        <td><span class="badge text-bg-light border">@x.Code</span></td>
                        <td>
                            <span class="fw-semibold">@x.Name</span>
                            @if (!string.IsNullOrEmpty(x.Description)) { <div class="small text-body-secondary text-truncate cell-desc">@x.Description</div> }
                        </td>
                        <td class="text-nowrap">@r.BudgetSubjectText</td>
                        <td class="text-end text-nowrap">@(x.MaxAmountPerItem is decimal m ? m.ToString("N0") : "不限")</td>
                        <td class="text-center">@if (x.RequiresReceipt) { <i class="bi bi-receipt text-primary" title="需附收據"></i> } else { <span class="text-body-secondary">—</span> }</td>
                        <td class="text-center">@if (x.IsActive) { <span class="badge text-bg-success">啟用</span> } else { <span class="badge text-bg-secondary">停用</span> }</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id"><i class="bi bi-pencil"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
