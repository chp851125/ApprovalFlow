@model EmailLogViewModel
@{
    ViewData["Title"] = "Email 寄送紀錄";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">排程與通知</a></li><li class="breadcrumb-item active">Email 寄送紀錄</li></ol></nav>
        <h1 class="page-title">Email 寄送紀錄</h1>
        <div class="text-body-secondary small">系統不連線寄信，郵件以 .eml 檔寫入 outbox 資料夾，可下載後用郵件軟體開啟。</div>
    </div>
</div>

<form method="get" asp-action="Emails" class="card mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label small mb-1" for="q">收件者 / 主旨</label>
            <input type="search" class="form-control" id="q" name="q" value="@Model.Q" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1" for="category">類別</label>
            <select class="form-select" id="category" name="category">
                <option value="">全部</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c" selected="@(c == Model.Category)">@(Enum.TryParse<NotificationType>(c, out var t) ? t.ToDisplay() : c)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1" for="emailStatus">狀態</label>
            <select class="form-select" id="emailStatus" name="emailStatus">
                <option value="">全部</option>
                @foreach (var st in Enum.GetValues<EmailStatus>())
                {
                    <option value="@st" selected="@(st == Model.Status)">@st.ToDisplay()</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-2"><button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>查詢</button></div>
    </div>
</form>

@if (Model.Rows.TotalCount == 0)
{
    <div class="card"><div class="card-body empty-state py-5">
        <div class="empty-state-icon"><i class="bi bi-envelope"></i></div>
        <p class="text-body-secondary mb-0">尚無寄送紀錄</p>
    </div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>時間</th><th>收件者</th><th>主旨</th><th>類別</th><th>狀態</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Rows.Items)
                    {
                        <tr>
                            <td class="small text-nowrap">@e.CreatedAt.ToString("MM/dd HH:mm:ss")</td>
                            <td class="small">@(e.RecipientId is int r ? Model.Names.GetValueOrDefault(r) : "")<div class="text-body-secondary">@e.To</div></td>
                            <td class="small"><a asp-action="Email" asp-route-id="@e.Id">@e.Subject</a></td>
                            <td class="small text-nowrap">@(Enum.TryParse<NotificationType>(e.Category, out var t) ? t.ToDisplay() : e.Category)</td>
                            <td><span class="badge @(e.Status == EmailStatus.Written ? "text-bg-success" : e.Status == EmailStatus.Failed ? "text-bg-danger" : "text-bg-secondary")">@e.Status.ToDisplay()</span></td>
                            <td class="text-end">@if (e.FileName != null) { <a class="btn btn-sm btn-outline-secondary" asp-action="Eml" asp-route-id="@e.Id" title="下載 .eml"><i class="bi bi-download"></i></a> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<partial name="_Pager" model="Model.Pager" />
