@model DashboardViewModel
@{
    ViewData["Title"] = "儀表板";
}
<div class="page-header">
    <div>
        <h1 class="page-title">儀表板</h1>
        <div class="text-body-secondary small">@(Model.ShowCompany ? "全公司簽核概況（近 12 個月，時間以工作小時計）" : "我的申請與簽核概況（近 12 個月）")</div>
    </div>
    @if (Model.IsAdmin)
    {
        <div class="btn-group" role="group" aria-label="切換檢視">
            <a class="btn btn-sm @(Model.ShowCompany ? "btn-primary" : "btn-outline-primary")" asp-action="Index"><i class="bi bi-buildings me-1"></i>全公司</a>
            <a class="btn btn-sm @(!Model.ShowCompany ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-view="me"><i class="bi bi-person me-1"></i>我的</a>
        </div>
    }
</div>

@if (Model.ShowCompany && Model.Company is { } c)
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-4 col-xxl-2"><div class="stat-card"><div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-files"></i></div><div><div class="stat-value">@c.SubmittedLast12Months</div><div class="stat-label">近 12 月送出</div></div></div></div>
        <div class="col-6 col-md-4 col-xxl-2"><div class="stat-card"><div class="stat-icon bg-info-subtle text-info-emphasis"><i class="bi bi-hourglass-split"></i></div><div><div class="stat-value">@c.InProgress</div><div class="stat-label">簽核中</div></div></div></div>
        <div class="col-6 col-md-4 col-xxl-2"><a class="stat-card text-decoration-none text-body" href="#overdue"><div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-alarm"></i></div><div><div class="stat-value">@c.Overdue</div><div class="stat-label">目前逾時</div></div></a></div>
        <div class="col-6 col-md-4 col-xxl-2"><div class="stat-card"><div class="stat-icon bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></div><div><div class="stat-value">@c.ApprovalRate.ToString("0.#")%</div><div class="stat-label">核准率</div></div></div></div>
        <div class="col-6 col-md-4 col-xxl-2"><div class="stat-card"><div class="stat-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-stopwatch"></i></div><div><div class="stat-value">@c.AvgCycleHours.ToString("0.#")</div><div class="stat-label">平均完成工時</div></div></div></div>
        <div class="col-6 col-md-4 col-xxl-2"><div class="stat-card"><div class="stat-icon bg-secondary-subtle text-secondary-emphasis"><i class="bi bi-speedometer2"></i></div><div><div class="stat-value">@c.SlaComplianceRate.ToString("0.#")%</div><div class="stat-label">時效達成率</div></div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-xl-8"><div class="card h-100"><div class="card-header fw-semibold">每月送出件數（依單別）</div><div class="card-body"><div class="chart" data-chart="monthly" data-kind="stack" role="img" aria-label="每月送出件數長條圖"></div></div></div></div>
        <div class="col-xl-4"><div class="card h-100"><div class="card-header fw-semibold">狀態分布</div><div class="card-body"><div class="chart" data-chart="status" data-kind="pie" role="img" aria-label="單據狀態圓餅圖"></div></div></div></div>
        <div class="col-xl-4 col-md-6"><div class="card h-100"><div class="card-header fw-semibold">各單別平均完成時間（工作小時）</div><div class="card-body"><div class="chart" data-chart="cycle" data-kind="bar" role="img" aria-label="平均完成時間"></div></div></div></div>
        <div class="col-xl-4 col-md-6"><div class="card h-100"><div class="card-header fw-semibold">今年費用類別（已核准，元）</div><div class="card-body"><div class="chart" data-chart="expense" data-kind="donut" role="img" aria-label="費用類別"></div></div></div></div>
        <div class="col-xl-4 col-md-6"><div class="card h-100"><div class="card-header fw-semibold">今年請假時數（已核准）</div><div class="card-body"><div class="chart" data-chart="leave" data-kind="hbar" role="img" aria-label="請假時數"></div></div></div></div>
        <div class="col-xl-6 col-md-6"><div class="card h-100"><div class="card-header fw-semibold">各部門送出件數</div><div class="card-body"><div class="chart" data-chart="dept" data-kind="hstack" role="img" aria-label="各部門件數"></div></div></div></div>

        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header fw-semibold d-flex justify-content-between">
                    <span>簽核效率（處理件數前 10 名）</span>
                    <a class="small" asp-controller="Reports" asp-action="Index" asp-route-report="approvers">完整報表 <i class="bi bi-chevron-right"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>簽核人</th><th class="text-end">件數</th><th class="text-end">平均工時</th><th class="text-end">逾時</th><th class="col-sla">時效達成率</th></tr></thead>
                        <tbody>
                            @foreach (var a in c.Approvers)
                            {
                                <tr>
                                    <td>@a.Name<div class="small text-body-secondary">@a.Department</div></td>
                                    <td class="text-end">@a.Handled</td>
                                    <td class="text-end">@a.AvgHours.ToString("0.#")</td>
                                    <td class="text-end @(a.Late > 0 ? "text-danger" : "")">@a.Late</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <progress class="sla-progress @(a.SlaRate >= 90 ? "is-good" : a.SlaRate >= 70 ? "is-mid" : "is-bad")" max="100" value="@a.SlaRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"></progress>
                                            <span class="small text-nowrap">@a.SlaRate.ToString("0.#")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12" id="overdue">
            <div class="card">
                <div class="card-header fw-semibold"><i class="bi bi-alarm text-danger me-2"></i>目前逾時單據</div>
                @if (c.OverdueNow.Count == 0)
                {
                    <div class="card-body small text-body-secondary">目前沒有逾時單據。</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>單號 / 主旨</th><th>申請人</th><th>關卡</th><th>待簽</th><th>期限</th><th class="text-end">已逾時（工時）</th></tr></thead>
                            <tbody>
                                @foreach (var o in c.OverdueNow)
                                {
                                    <tr>
                                        <td><a asp-controller="Documents" asp-action="Details" asp-route-id="@o.Id">@o.DocumentNo</a><div class="small text-truncate cell-desc">@o.Title</div></td>
                                        <td>@o.Applicant</td>
                                        <td class="small">@o.StepName</td>
                                        <td class="small">@o.Assignees</td>
                                        <td class="small text-nowrap">@o.DueAt.ToString("MM/dd HH:mm")</td>
                                        <td class="text-end text-danger fw-semibold">@o.OverdueHours.ToString("0.#")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}
else if (Model.Personal is { } p)
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-4 col-xxl"><a class="stat-card text-decoration-none text-body" asp-controller="Documents" asp-action="Index" asp-route-box="todo"><div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-inbox"></i></div><div><div class="stat-value">@p.PendingCount</div><div class="stat-label">待我簽核@(p.PendingOverdue > 0 ? $"（{p.PendingOverdue} 逾時）" : "")</div></div></a></div>
        <div class="col-6 col-md-4 col-xxl"><a class="stat-card text-decoration-none text-body" asp-controller="Documents" asp-action="Index" asp-route-box="mine"><div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-hourglass-split"></i></div><div><div class="stat-value">@p.MyInProgress</div><div class="stat-label">我的簽核中</div></div></a></div>
        <div class="col-6 col-md-4 col-xxl"><div class="stat-card"><div class="stat-icon bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></div><div><div class="stat-value">@p.MyApprovedThisYear</div><div class="stat-label">今年已核准</div></div></div></div>
        <div class="col-6 col-md-4 col-xxl"><div class="stat-card"><div class="stat-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-receipt"></i></div><div><div class="stat-value">@p.MyExpenseThisYear.ToString("N0")</div><div class="stat-label">今年報銷（元）</div></div></div></div>
        <div class="col-12 col-md-4 col-xxl"><div class="stat-card"><div class="stat-icon bg-info-subtle text-info-emphasis"><i class="bi bi-stopwatch"></i></div><div><div class="stat-value">@(p.MyAvgApprovalHours?.ToString("0.#") ?? "—")</div><div class="stat-label">我的平均簽核工時</div></div></div></div>
    </div>
    <div class="row g-3">
        <div class="col-xl-8"><div class="card h-100"><div class="card-header fw-semibold">我每月送出的申請</div><div class="card-body"><div class="chart" data-chart="monthly" data-kind="stack" role="img" aria-label="每月申請件數"></div></div></div></div>
        <div class="col-xl-4"><div class="card h-100"><div class="card-header fw-semibold">我的申請狀態</div><div class="card-body"><div class="chart" data-chart="status" data-kind="pie" role="img" aria-label="申請狀態"></div></div></div></div>
        <div class="col-xl-6"><div class="card h-100"><div class="card-header fw-semibold">今年假別使用（小時）</div><div class="card-body"><div class="chart" data-chart="leaveBalance" data-kind="hstack" role="img" aria-label="假別使用"></div></div></div></div>
        <div class="col-xl-6"><div class="card h-100"><div class="card-header fw-semibold">我每月處理的簽核</div><div class="card-body"><div class="chart" data-chart="handled" data-kind="stack" role="img" aria-label="每月處理簽核件數"></div></div></div></div>
    </div>
}

<script type="application/json" id="dashboardData">@Html.Raw(Model.ChartJson)</script>

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
