@model LeaveTypeEditViewModel
@{
    var isNew = Model.Input.Id == 0;
    ViewData["Title"] = isNew ? "新增假別" : "編輯假別";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">假別設定</a></li><li class="breadcrumb-item active">@ViewData["Title"]</li></ol></nav>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form method="post" asp-action="Save" novalidate>
            <input type="hidden" asp-for="Input.Id" />
            <input type="hidden" asp-for="Input.Version" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>
            <div class="row g-3">
                <div class="col-sm-4">
                    <label asp-for="Input.Code" class="form-label required"></label>
                    <input asp-for="Input.Code" class="form-control text-uppercase" maxlength="20" />
                    <span asp-validation-for="Input.Code" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-sm-8">
                    <label asp-for="Input.Name" class="form-label required"></label>
                    <input asp-for="Input.Name" class="form-control" maxlength="20" />
                    <span asp-validation-for="Input.Name" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Input.DefaultQuotaHours" class="form-label"></label>
                    <input asp-for="Input.DefaultQuotaHours" class="form-control" type="number" min="0" max="2000" step="0.5" />
                    <span asp-validation-for="Input.DefaultQuotaHours" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-sm-6 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="Input.UseSeniorityQuota" class="form-check-input" role="switch" />
                        <label asp-for="Input.UseSeniorityQuota" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-6 col-sm-4">
                    <label asp-for="Input.PayRatio" class="form-label"></label>
                    <input asp-for="Input.PayRatio" class="form-control" type="number" min="0" max="1" step="0.1" />
                    <span asp-validation-for="Input.PayRatio" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-6 col-sm-4">
                    <label asp-for="Input.MinUnitHours" class="form-label"></label>
                    <select asp-for="Input.MinUnitHours" class="form-select">
                        <option value="0.5">0.5 小時</option>
                        <option value="1">1 小時</option>
                        <option value="2">2 小時</option>
                        <option value="4">半天（4 小時）</option>
                        <option value="8">1 天（8 小時）</option>
                    </select>
                    <span asp-validation-for="Input.MinUnitHours" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-sm-4">
                    <label asp-for="Input.SortOrder" class="form-label"></label>
                    <input asp-for="Input.SortOrder" class="form-control" type="number" min="0" max="999" />
                    <span asp-validation-for="Input.SortOrder" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="2" maxlength="200"></textarea>
                    <span asp-validation-for="Input.Description" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-12 d-flex flex-wrap gap-4">
                    <div class="form-check form-switch">
                        <input asp-for="Input.RequiresAttachment" class="form-check-input" role="switch" />
                        <label asp-for="Input.RequiresAttachment" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="Input.IsActive" class="form-check-input" role="switch" />
                        <label asp-for="Input.IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>儲存</button>
            </div>
        </form>
    </div>
</div>
