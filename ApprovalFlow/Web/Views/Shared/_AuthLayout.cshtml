@inject LayoutService LayoutData
@{
    var company = await LayoutData.GetCompanyNameAsync();
}
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1f3a5f" />
    <title>@ViewData["Title"] - @company 簽核系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-wrap">
        <div class="auth-card card shadow-lg border-0">
            <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                    <div class="auth-logo"><i class="bi bi-diagram-3-fill"></i></div>
                    <h1 class="h5 fw-bold mb-1">@company</h1>
                    <div class="text-body-secondary small">電子簽核系統</div>
                </div>
                @RenderBody()
            </div>
        </div>
        <p class="text-center text-white-50 small mt-3 mb-0">© @DateTime.Now.Year @company</p>
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
