@inject LayoutService LayoutData
@inject IWebHostEnvironment Env
@{
    var user = await LayoutData.GetUserAsync();
    var company = await LayoutData.GetCompanyNameAsync();
    var pageTitle = ViewData["Title"] as string;
    // 頁面可設定 ViewData["HideStickyActions"] = true 來隱藏已定義的固定動作列
    var showSticky = IsSectionDefined("StickyActions") && ViewData["HideStickyActions"] is not true;
    // ViewData["StickyActionsMobileOnly"] = true：桌機已在頁面內顯示按鈕，只在手機顯示固定列
    var stickyMobileOnly = ViewData["StickyActionsMobileOnly"] is true;
    if (IsSectionDefined("StickyActions") && !showSticky) { IgnoreSection("StickyActions"); }
}
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1f3a5f" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? "" : pageTitle + " - ")@company 簽核系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app @(showSticky ? "has-sticky-actions" : "") @(showSticky && stickyMobileOnly ? "sticky-mobile-only" : "")">
    <a class="visually-hidden-focusable skip-link" href="#main">跳至主要內容</a>

    <header class="app-topbar">
        <button class="btn btn-link text-white d-lg-none px-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="開啟選單">
            <i class="bi bi-list fs-4"></i>
        </button>
        <a class="app-brand" asp-controller="Home" asp-action="Index">
            <span class="app-brand-icon"><i class="bi bi-diagram-3-fill"></i></span>
            <span class="app-brand-text">
                <span class="d-none d-sm-inline">@company</span>
                <span class="d-sm-none">簽核系統</span>
                <small class="d-none d-sm-inline">簽核系統</small>
            </span>
        </a>

        <div class="ms-auto d-flex align-items-center gap-2">
            @if (Env.IsDevelopment())
            {
                <div class="d-none d-xl-block quick-switch-top">
                    @await Component.InvokeAsync("QuickSwitch", new { variant = "navbar" })
                </div>
            }
            @if (user != null)
            {
                <partial name="_NotificationBell" />
                <div class="dropdown">
                    <button class="btn btn-link text-white text-decoration-none d-flex align-items-center gap-2 px-1" data-bs-toggle="dropdown" aria-expanded="false" aria-label="使用者選單">
                        <span class="avatar">@user.Initial</span>
                        <span class="d-none d-md-inline text-start lh-sm">
                            <span class="d-block fw-semibold">@user.Name</span>
                            <small class="opacity-75">@user.DepartmentName・@user.TitleName</small>
                        </span>
                        <i class="bi bi-chevron-down small d-none d-md-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li class="px-3 py-2 small text-body-secondary">
                            <div class="fw-semibold text-body">@user.Name（@user.Account）</div>
                            <div>@user.DepartmentName・@user.TitleName</div>
                            <div><i class="bi bi-shield-check"></i> @user.RoleText</div>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Delegations" asp-action="Index"><i class="bi bi-person-check me-2"></i>代理人設定</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>變更密碼</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form method="post" asp-controller="Account" asp-action="Logout">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>登出</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </header>

    <div class="app-shell">
        <aside class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
            <div class="offcanvas-header d-lg-none">
                <h5 class="offcanvas-title" id="appSidebarLabel">@company</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="關閉"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <partial name="_Sidebar" model="user" />
                @if (Env.IsDevelopment())
                {
                    <div class="p-3 mt-auto d-xl-none border-top border-white border-opacity-10">
                        <div class="small text-white-50 mb-1">開發模式</div>
                        @await Component.InvokeAsync("QuickSwitch", new { variant = "sidebar" })
                    </div>
                }
            </div>
        </aside>

        <main class="app-main" id="main">
            <div class="container-fluid app-content">
                <partial name="_Alerts" />
                @RenderBody()
            </div>
        </main>
    </div>

    @if (showSticky)
    {
        <div class="app-sticky-actions @(stickyMobileOnly ? "d-lg-none" : "")">
            @await RenderSectionAsync("StickyActions")
        </div>
    }

    <partial name="_BottomNav" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
