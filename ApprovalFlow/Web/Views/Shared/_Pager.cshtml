@model PagerModel
@{
    string PageUrl(int page)
    {
        var values = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = page.ToString() };
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            Url.Action(Model.Action) ?? "", values.Where(kv => !string.IsNullOrEmpty(kv.Value)));
    }
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <div class="small text-body-secondary">
        @if (Model.TotalCount == 0)
        {
            <span>沒有符合條件的資料</span>
        }
        else
        {
            <span>第 @Model.FirstItem～@Model.LastItem 筆，共 @Model.TotalCount 筆</span>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="分頁">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Model.Page - 1)" aria-label="上一頁"><i class="bi bi-chevron-left"></i></a>
                </li>
                @if (start > 1)
                {
                    <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                    if (start > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                }
                @for (var p = start; p <= end; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")" aria-current="@(p == Model.Page ? "page" : null)">
                        <a class="page-link" href="@PageUrl(p)">@p</a>
                    </li>
                }
                @if (end < Model.TotalPages)
                {
                    if (end < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                    <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Model.Page + 1)" aria-label="下一頁"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
</div>
